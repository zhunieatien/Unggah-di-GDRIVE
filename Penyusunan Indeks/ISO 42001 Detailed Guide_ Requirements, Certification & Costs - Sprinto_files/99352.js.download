jQuery(document).ready(function($){if($(".wp-block-cb-carousel-v2.swipe-mode").length){sliderSwipeMode("swipe-mode")}
if($(".ins-nav-slider.wp-block-cb-carousel-v2").length){setTimeout(function(){shiftNavContent()},300)}
function shiftNavContent(){const slides=$(".ins-nav-slider .wp-block-cb-slide-v2");const navBar=$(".ins-nav-slider .cb-pagination  > .swiper-pagination-bullet");if(slides.length>0){slides.each(function(ind,ele){const element=$(ele).find(".slider-nav-content");if(element.length>0){const clone=element.clone();const slideLoc=$(ele).attr("data-swiper-slide-index").trim().charAt(0);$(ele).closest(".ins-nav-slider").find(".cb-pagination  > .swiper-pagination-bullet").eq(slideLoc).find(".slider-nav-content").remove();$(ele).closest(".ins-nav-slider").find(".cb-pagination  > .swiper-pagination-bullet").eq(slideLoc).append(clone)}})}}
function sliderSwipeMode(swipeMode){const centerSliders=document.querySelectorAll('.wp-block-cb-carousel-v2.'+swipeMode+' .swiper');centerSliders.forEach(container=>{setTimeout(()=>{const oldSwiper=container.swiper;if(oldSwiper){const originalParams=oldSwiper.params;oldSwiper.destroy(!0,!0);new Swiper(container,{...originalParams,allowSlidePrev:!0,allowSlideNext:!0,simulateTouch:!0,allowTouchMove:!0,mousewheel:{forceToAxis:!0,releaseOnEdges:!0,thresholdDelta:1,thresholdTime:300},keyboard:{enabled:!0},navigation:originalParams.navigation,pagination:originalParams.pagination})}},200)})}})