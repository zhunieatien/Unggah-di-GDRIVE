jQuery(document).ready(function($){if(window.location.href===window.location.origin+'/'){console.log('Homepage detected!')}else{if(window.location.href.includes("overlap-calculator-team-showcase")){multiframework_submit([84,86,85,93,121],[84,72,68,81,75],'soc2');jQuery("#ff_8_dropdown_5").val("soc2");jQuery(".ccf-result-table").removeClass('result-row')}}});if(window.location.href===window.location.origin+'/'){console.log('Homepage detected!')}else{function multiframework_submit(count_s,counter_overlap,frameWork){jQuery('.ccf-soc2-required span, .ccf-gdpr-required span, .ccf-hipaa-required span,  .ccf-iso-required span, .ccf-pci-required span, .ccf-soc2-overlap span, .ccf-gdpr-overlap span, .ccf-hipaa-overlap span, .ccf-iso-overlap span, .ccf-pci-overlap span, .ccf-soc2-effort span, .ccf-gdp-effort span, .ccf-hipaa-effort span, .ccf-iso-effort span, .ccf-pci-effort span, .ccf-soc2-overlap_percent span, .ccf-gdpr-overlap_percent span, .ccf-hipaa-overlap_percent span, .ccf-iso-overlap_percent span, .ccf-pci-overlap_percent span, .selected-framework .ccf-tool').remove();jQuery('.ccf-tool').removeClass("ccf-lap-100");counters=count_s;selectedFramework="";if(frameWork=='soc2'){selectedFramework="SOC 2"}else if(frameWork=='gdpr'){selectedFramework="GDPR"}else if(frameWork=='hipaa'){selectedFramework="HIPAA"}else if(frameWork=='iso27001-2022'){selectedFramework="ISO 27001"}else{selectedFramework="PCI DSS"}
jQuery('.ccf-soc2-required').append("<span> "+counters[0]+"</span>");jQuery('.ccf-gdpr-required').append("<span> "+counters[1]+"</span>");jQuery('.ccf-hipaa-required').append("<span> "+counters[2]+"</span>");jQuery('.ccf-iso-required').append("<span> "+counters[3]+"</span>");jQuery('.ccf-pci-required').append("<span> "+counters[4]+"</span>");overlap_count=counter_overlap;overlap_percent=[];overlap_stroke=[];efforts=[];for(i=0;i<overlap_count.length;i++){overlap_percent[i]=Math.round((overlap_count[i]/counters[i])*100);if(i==4){efforts[i]=Math.round((((4*(100-overlap_percent[i])/100).toFixed(1)*30)/120)*100)}else{efforts[i]=Math.round((((2.25*(100-overlap_percent[i])/100).toFixed(1)*30)/66)*100)}}
circle1=280-(280*overlap_percent[0]/100);circle2=280-(280*overlap_percent[1]/100);circle3=280-(280*overlap_percent[2]/100);circle4=280-(280*overlap_percent[3]/100);circle5=280-(280*overlap_percent[4]/100);jQuery('.ccf-soc2-overlap_percent').prepend("<span>"+overlap_percent[0]+"% </span>");if(overlap_percent[0]>60){overlap_stroke[0]="#0057FF"}else{overlap_stroke[0]="#F9C723"}
jQuery('.ccf-soc2-overlap_percent').parents(".overlap-progress").find("svg circle").css({"stroke-dashoffset":circle1,"stroke":overlap_stroke[0]});if(overlap_percent[0]=='100'){jQuery('.ccf-soc2-overlap_percent').parents(".ccf-soc2").addClass("ccf-lap-"+overlap_percent[0])}
jQuery('.ccf-gdpr-overlap_percent').prepend("<span>"+overlap_percent[1]+"% </span>");if(overlap_percent[1]>60){overlap_stroke[1]="#0057FF"}else{overlap_stroke[1]="#F9C723"}
jQuery('.ccf-gdpr-overlap_percent').parents(".overlap-progress").find("svg circle").css({"stroke-dashoffset":circle2,"stroke":overlap_stroke[1]});if(overlap_percent[1]=='100'){jQuery('.ccf-gdpr-overlap_percent').parents('.ccf-gdpr').addClass("ccf-lap-"+overlap_percent[1])}
jQuery('.ccf-hipaa-overlap_percent').prepend("<span>"+overlap_percent[2]+"% </span>");if(overlap_percent[2]>60){overlap_stroke[2]="#0057FF"}else{overlap_stroke[2]="#F9C723"}
jQuery('.ccf-hipaa-overlap_percent').parents(".overlap-progress").find("svg circle").css({"stroke-dashoffset":circle3,"stroke":overlap_stroke[2]});if(overlap_percent[2]=='100'){jQuery('.ccf-hipaa-overlap_percent').parents('.ccf-hipaa').addClass("ccf-lap-"+overlap_percent[2])}
jQuery('.ccf-iso-overlap_percent').prepend("<span>"+overlap_percent[3]+"% </span>");if(overlap_percent[3]>60){overlap_stroke[3]="#0057FF"}else{overlap_stroke[3]="#F9C723"}
jQuery('.ccf-iso-overlap_percent').parents(".overlap-progress").find("svg circle").css({"stroke-dashoffset":circle4,"stroke":overlap_stroke[3]});if(overlap_percent[3]=='100'){jQuery('.ccf-iso-overlap_percent').parents('.ccf-iso').addClass("ccf-lap-"+overlap_percent[3])}
jQuery('.ccf-pci-overlap_percent').prepend("<span>"+overlap_percent[4]+"% </span>");if(overlap_percent[4]>60){overlap_stroke[4]="#0057FF"}else{overlap_stroke[4]="#F9C723"}
jQuery('.ccf-pci-overlap_percent').parents(".overlap-progress").find("svg circle").css({"stroke-dashoffset":circle5,"stroke":overlap_stroke[4]});if(overlap_percent[4]=='100'){jQuery('.ccf-pci-overlap_percent').parents('.ccf-pcidss').addClass("ccf-lap-"+overlap_percent[4])}
count_overlap=counter_overlap;jQuery('.ccf-soc2-overlap').append("<span> "+count_overlap[0]+"</span>");jQuery('.ccf-gdpr-overlap').append("<span> "+count_overlap[1]+"</span>");jQuery('.ccf-hipaa-overlap').append("<span> "+count_overlap[2]+"</span>");jQuery('.ccf-iso-overlap').append("<span> "+count_overlap[3]+"</span>");jQuery('.ccf-pci-overlap').append("<span> "+count_overlap[4]+"</span>");jQuery('.ccf-soc2-effort').append("<span> "+efforts[0]+"%</span>");jQuery('.ccf-gdp-effort').append("<span> "+efforts[1]+"%</span>");jQuery('.ccf-hipaa-effort').append("<span> "+efforts[2]+"%</span>");jQuery('.ccf-iso-effort').append("<span> "+efforts[3]+"%</span>");jQuery('.ccf-pci-effort').append("<span> "+efforts[4]+"%</span>");jQuery(".selected-framework").find(".selected-compliance-name").text(selectedFramework);delete counters;delete efforts;delete overlap_count;delete overlap_percent;delete selectedFramework}
var selectFrameValue;jQuery('#ff_7_dropdown_5, select#ff_9_dropdown_5').on('change',function(){selectFrameValue=jQuery(this).val();console.log(selectFrameValue)});jQuery("#fluentform_7, #fluentform_9").find('.ff-btn-submit').on('click',function(e){if(jQuery("#fluentform_7").length>0){if(jQuery("#fluentform_7")[0].checkValidity()){}else{return}}
